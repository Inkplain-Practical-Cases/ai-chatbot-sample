    {
      "id": "chat-router",
      "type": "diagramNode",
      "position": { "x": -400, "y": 260 },
      "width": 360,
      "height": 170,
      "data": {
        "label": "Chat Router (thin door)",
        "icon": "process-executor",
        "shape": "module",
        "color": "#1677ff",
        "linkedCanvasId": "chat-router-canvas",
        "linkedCanvasName": "Chat Router",
        "operationSteps": [
          {
            "id": "cr-1",
            "order_no": 1,
            "showInDiagram": true,
            "title": "Declare /ws/chat route",
            "description": "Injects embedder, vectorstore, and llm singletons via Depends(), then calls handle_chat_socket(). Contains zero business logic — per the CDAF thin-door rule."
          }
        ],
        "attributes": [
          { "id": "b1", "key": "unit_type", "value": "endpoint" },
          { "id": "b2", "key": "route", "value": "WS /ws/chat" },
          { "id": "b3", "key": "source_file", "value": "app/features/feature_chat/router.py" },
          { "id": "b4", "key": "generated_by", "value": "Claude" }
        ],
        "fields": [],
        "body": "",
        "config": {},
        "emoji": "",
        "boxView": true,
