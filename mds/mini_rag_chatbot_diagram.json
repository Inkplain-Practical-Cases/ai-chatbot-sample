      "type": "diagramNode",
      "position": { "x": 550, "y": 860 },
      "width": 360, "height": 170,
      "data": {
        "label": "FE Receive Stream",
        "icon": "process-executor",
        "shape": "module",
        "color": "#1677ff",
        "linkedCanvasId": "fe-receive-canvas",
        "linkedCanvasName": "FE Receive Stream",
        "operationSteps": [
          {
            "id": "fr-1",
            "order_no": 1,
            "showInDiagram": true,
            "title": "Append streamed tokens",
            "description": "Each {\"type\": \"stream\"} appends text to the current bot message bubble, before a blinking cursor."
          },
          {
            "id": "fr-2",
            "order_no": 2,
            "showInDiagram": true,
            "title": "Finish or show error",
            "description": "{\"type\": \"done\"} removes the cursor. {\"type\": \"error\"} shows the message but leaves the socket open for the next question."
          }
        ],
        "attributes": [
          { "id": "j1", "key": "unit_type", "value": "boundary" },
          { "id": "j2", "key": "source_file", "value": "test_client.html" },
